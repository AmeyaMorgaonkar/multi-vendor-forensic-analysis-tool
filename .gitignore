# Forensic Evidence Storage (Never commit evidence binaries)
evidence_store/case_*
evidence_store/uploads/*
evidence_store/raw_images/*
!evidence_store/raw_images/.gitkeep
evidence_store/extracted/*
!evidence_store/extracted/.gitkeep
evidence_store/recovered/*
!evidence_store/recovered/.gitkeep
evidence_store/reports/*
!evidence_store/reports/.gitkeep

# Temporary / OS files
tmp/
temp/

